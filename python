

import cv2
import mediapipe as mp

import requests


mp_hands= mp.solutions.hands
hands=mp_hands.Hands()
mp_draw = mp.solutions.drawing_utils
x1, y1 = 100, 50
x2, y2 = 200, 100

x3, y3 = 300, 50
x4, y4 = 400, 100

x5, y5 = 500, 50
x6, y6 = 600, 100




cap=cv2.VideoCapture(0)



estado = 0
while True:
    ret,frame=cap.read()
    if not(ret):

        break
    frame = cv2.flip(frame, 1)
    rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    results = hands.process(rgb)

    if results.multi_hand_landmarks:

        h, w, c = frame.shape

        for hand in results.multi_hand_landmarks:

            mp_draw.draw_landmarks(
                frame,
                hand,
                mp_hands.HAND_CONNECTIONS
            )

            dedo = hand.landmark[8]

            x = int(dedo.x * w)
            y = int(dedo.y * h)

            cv2.circle(frame, (x, y), 10, (255, 0, 0), -1)

            if x1 < x < x2 and y1 < y < y2:

                if estado != 1:
                    requests.get("http://192.168.0.102/vermelho")
                    estado = 1

            elif x3 < x < x4 and y3 < y < y4:

                if estado != 2:
                    requests.get("http://192.168.0.102/amarelo")
                    estado = 2

            elif x5 < x < x6 and y5 < y < y6:

                if estado != 3:
                    requests.get("http://192.168.0.102/verde")
                    estado = 3

    cv2.rectangle(frame, (100, 50), (200, 100), (0, 0, 255), -1)
    cv2.putText(frame, "Led", (125, 90), cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 0, 0), 2)

    cv2.rectangle(frame, (300, 50), (400, 100), (0, 255, 255), -1)
    cv2.putText(frame, "Led", (325, 90), cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 0, 0), 2)

    cv2.rectangle(frame, (500, 50), (600, 100), (0, 255, 0), -1)
    cv2.putText(frame,"Led",(525,90),cv2.FONT_HERSHEY_SIMPLEX,1,(0,0,0),2)






    cv2.imshow('frame',frame)
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()


